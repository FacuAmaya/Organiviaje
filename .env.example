# Copiar a .env y ajustar. El .env nunca se commitea.

# ── App ──
APP_ENV=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# ── Base de datos (docker compose) ──
POSTGRES_USER=organiviaje
POSTGRES_PASSWORD=organiviaje
POSTGRES_DB=organiviaje
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://organiviaje:organiviaje@localhost:5433/organiviaje
DATABASE_ECHO=false

# Base de los tests de integración (la crea backend/scripts/init-test-db.sql)
TEST_DATABASE_URL=postgresql+asyncpg://organiviaje:organiviaje@localhost:5433/organiviaje_test
